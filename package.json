{
  "name": "ts-starter",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "description": "My awesome typescript library",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/ts-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/ts-starter.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/ts-starter/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build",
    "s01": "tsx src/sessions/s01-agent-loop.ts",
    "s02": "tsx src/sessions/s02-tool-use.ts",
    "s03": "tsx src/sessions/s03-todo-write.ts",
    "s04": "tsx src/sessions/s04-subagent.ts"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@anthropic-ai/sdk": "^0.98.0",
    "@types/node": "^25.6.0",
    "@typescript/native-preview": "7.0.0-dev.20260517.1",
    "cac": "^7.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.1",
    "eslint-plugin-format": "^1.0.2",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
